---
import MainLayout from '@/layouts/MainLayout.astro';
import AccountsPanel from '@/components/AccountsPanel';
import { t } from '@/i18n';
import { localeFromPath } from '@/i18n/routing';
import { isOAuthEnabled } from '@/server/cf/oauth';
import { runtimeEnv } from '@/server/env';
const locale = localeFromPath(Astro.url.pathname);
const oauthEnabled = isOAuthEnabled(runtimeEnv(Astro.locals));
---
<MainLayout title={t(locale, 'accounts.pageTitle')} locale={locale}>
  <AccountsPanel client:load locale={locale} oauthEnabled={oauthEnabled} />
</MainLayout>
